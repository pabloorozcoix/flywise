# AeroAgent AI — Environment Variables
# Copy this file to .env and adjust values as needed.

# === Ollama ===
# Inside Docker network (used by services)
OLLAMA_HOST=http://ollama:11434
# Ollama model name
OLLAMA_MODEL=qwen3:8b

# === Browser-Use Service ===
BROWSER_USE_API_URL=http://browser-use:8000

# === PostgreSQL (Supabase Postgres) ===
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
# Inside Docker network
DATABASE_URL=postgresql://postgres:postgres@supabase-db:5432/postgres
# From host machine
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# === Supabase (optional — only if using full Supabase stack) ===
SUPABASE_ANON_KEY=not-required-for-local

# === OpenAI ===
OPENAI_API_KEY=SECRET

# === Application ===
CACHE_TTL_MINUTES=60
